# PostgreSQL connection. Create the database/user before running migrations.
DATABASE_URL=postgresql://preppx:change-me@localhost:5432/preppx

# Use a cryptographically random value of at least 32 characters.
MANAGEMENT_JWT_SECRET=replace-with-at-least-32-random-characters
FRONTEND_ORIGIN=http://localhost:5173
# Comma-separated additional exact origins, e.g. http://192.168.1.20:5173 for LAN testing.
FRONTEND_ORIGINS=
API_PORT=3001
COOKIE_SECURE=false

# Optional. Set all three to create/update the management bootstrap account.
MANAGEMENT_BOOTSTRAP_NAME=
MANAGEMENT_BOOTSTRAP_EMAIL=
MANAGEMENT_BOOTSTRAP_PASSWORD=

# Required for student registration, sign-in OTP, and password recovery.
RESEND_API_KEY=
# Must be an email address or "PREPPX <email@your-verified-domain.com>".
# Verify the sender's domain in Resend before using it for student email.
EMAIL_FROM=

# Optional private S3-compatible storage. Set every value together.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
